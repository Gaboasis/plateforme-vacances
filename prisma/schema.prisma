generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Educator {
  id            String   @id
  name          String
  email         String   @unique
  role          String   // "educatrice" | "admin" | "cuisiniere" | "entretien" | "secretaire"
  seniorityRank Int?
  isQualified   Boolean?
  passwordHash  String?
  hourlyRateCents Int? // cents, ex. 2550 = 25,50 $
  employerContributionPercent Float? // % du salaire brut (cotisations employeur)
  vacationIndemnityPercent Float? @default(4) // 4 ou 6 — indemnité vacances sur brut
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AccountingConfig {
  id                              String   @id @default("default")
  dailyChildRateCents             Int      @default(4500) // legacy
  dailyInfantRateCents            Int      @default(5200) // poupon 6–18 mois
  dailyOver18RateCents            Int      @default(4500) // 18 mois et +
  defaultEmployerContributionPercent Float @default(18) // mode flat_percent seulement
  employerContributionMethod      String   @default("quebec_statutory") // quebec_statutory | flat_percent
  qcRrqEmployerPercent            Float    @default(6.3)
  qcAeEmployerPercent             Float    @default(1.82)
  qcRqapEmployerPercent           Float    @default(0.602)
  qcFssEmployerPercent              Float    @default(1.65)
  qcCnesstEmployerPercent         Float    @default(1.15)
  sickLeaveIndemnityPercent       Float    @default(0.8) // provision maladie sur brut
  updatedAt                       DateTime @updatedAt
}

model FixedExpenseEntry {
  id           String   @id @default(cuid())
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  label        String
  amountCents  Int
  sourceName   String?
  note         String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([periodStart, periodEnd])
}

model DailyJournal {
  id            String        @id @default(cuid())
  journalDate   DateTime      @unique @db.Date
  notes         String?       @db.Text
  updatedById   String
  updatedByName String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         JournalLine[]
}

model JournalLine {
  id                          String       @id @default(cuid())
  journalId                   String
  journal                     DailyJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  kind                        String       // "expense" | "revenue"
  category                    String       // revenue_enrollment_infant | revenue_enrollment_over18 | revenue_enrollment (legacy) | revenue_other | ...
  label                       String?
  amountCents                 Int
  educatorId                  String?
  educatorName                String?
  hoursWorked                 Float?
  hourlyRateCents             Int?
  employerContributionPercent Float?
  childCount                  Int?
  dailyRateCents              Int?
  sortOrder                   Int          @default(0)

  @@index([journalId])
}

model VacationRequest {
  id                  String    @id @default(cuid())
  educatorId          String
  educatorName        String
  startDate           DateTime
  endDate             DateTime
  reason              String?
  status              String    // "pending" | "accepted" | "rejected" | "cancelled"
  rejectionReason     String?
  urgentAppealReason  String?   // Raison d'urgence soumise par l'éducatrice
  appealReviewedAt    DateTime? // Quand l'admin a traité l'appel
  legacyImport        Boolean   @default(false) // Pré-plateforme (affichage) ; inclus dans les calculs de règles comme tout congé accepté
  createdAt           DateTime  @default(now())
  reviewedAt          DateTime?
  cancelledAt         DateTime?
  cancellationPendingAt DateTime? // Employé : demande d’annulation après échéance (en attente admin)
  adminCancellationReason String? @db.Text // Message admin à l’employé lors de l’annulation d’un congé accepté
  adminAppealMessage      String? @db.Text // Message admin à l’employé après traitement d’une urgence motivée
}

model VacationRulesConfig {
  id        String   @id @default("default")
  rules     String   // JSON stringifié
  updatedAt DateTime @updatedAt
}

// Déclaration d'absence maladie (sans workflow congés)
model SickLeaveReport {
  id               String   @id @default(cuid())
  educatorId       String
  educatorName     String
  startDate        DateTime
  endDate          DateTime
  note             String?
  attachmentBase64 String?  @db.Text
  attachmentMime   String?
  attachmentName   String?
  // Employé a coché « je n'ai pas de document à fournir » (obligatoire si pas de fichier)
  declaredNoAttachment Boolean @default(false)
  createdAt        DateTime @default(now())
}

// Demande d’échange de journée de congé hebdomadaire entre éducatrices
model DayOffSwapRequest {
  id                  String    @id @default(cuid())
  requesterId         String
  requesterName       String
  requesterIsQualified Boolean  @default(false)
  requesterOffDay     Int       // 1 = lundi … 7 = dimanche (ISO, getISODay)
  mode                String    // "open" | "targeted"
  targetEducatorId    String?
  targetEducatorName  String?

  status              String    // "pending" | "confirmed" | "cancelled"
  acceptedById        String?
  acceptedByName      String?
  counterpartyOffDay  Int?      // jour de congé de la collègue qui accepte
  acceptedAt          DateTime?

  message             String?   @db.Text

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([targetEducatorId])
}

// Journal technique : qui a soumis quoi, depuis quelle IP / navigateur (traçabilité interne)
model ActivityAuditLog {
  id           String   @id @default(cuid())
  educatorId   String
  educatorName String
  action       String
  resourceType String
  resourceId   String?
  detail       String?  @db.Text
  ip           String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([educatorId])
}
